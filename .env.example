# Salin file ini menjadi .env lalu isi nilainya.
# .env tidak di-commit (lihat .gitignore).

# Wajib
SWARMFOLD_API_KEY=
SWARMFOLD_BASE_URL=http://<host>:<port>/v1
SWARMFOLD_MODEL=ag/gemini-3.8-flash-high

# Opsional (default di bawah)
SWARMFOLD_MAX_CELLS=120
SWARMFOLD_CELL_TIMEOUT_S=300
SWARMFOLD_STALL_CELLS=3
SWARMFOLD_DEEPDIVE_EVERY=10
SWARMFOLD_DATA_ROOT=/runs

# Parameter model. Kosong berarti tidak dikirim, jadi default gateway berlaku.
# temperature: 0 = paling stabil, 2 = paling acak. Worker yang diukur benchmark
# sebaiknya rendah, supaya selisih yang dinilai gerbang tidak tenggelam di noise.
SWARMFOLD_TEMPERATURE=
SWARMFOLD_TOP_P=
SWARMFOLD_SEED=
# Plafon token keluaran. Angka maksimum berbeda per gateway, jadi isi sendiri;
# dibiarkan kosong berarti plafon gateway.
SWARMFOLD_MAX_TOKENS=

# Model untuk peran reviewer di loop evolusi. Kosong berarti model worker dipakai.
SWARMFOLD_REVIEWER_MODEL=

# Pack doktrin analisis (default: business/UMKM)
SWARMFOLD_PACK=business
SWARMFOLD_AUDIENCE=pemilik usaha kecil
SWARMFOLD_DOMAIN=usaha
