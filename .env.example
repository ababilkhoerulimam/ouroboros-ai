# Salin file ini menjadi .env lalu isi nilainya.
# .env tidak di-commit (lihat .gitignore).

# Wajib
SWARMFOLD_API_KEY=
SWARMFOLD_BASE_URL=http://<host>:<port>/v1
SWARMFOLD_MODEL=ag/gemini-3.8-flash-high

# Opsional (default di bawah)
SWARMFOLD_MAX_CELLS=120
SWARMFOLD_CELL_TIMEOUT_S=300
SWARMFOLD_STALL_CELLS=3
SWARMFOLD_DEEPDIVE_EVERY=10
SWARMFOLD_DATA_ROOT=/runs
